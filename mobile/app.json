{
  "expo": {
    "name": "Nutrition Estimator",
    "slug": "nutrition-estimator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#81C784"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seniordesign.nutritionestimator",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to your camera to take photos of your meals for nutrition estimation.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select meal photos for nutrition estimation.",
        "NSMicrophoneUsageDescription": "This app does not use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#81C784"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.seniordesign.nutritionestimator",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image-picker",
      "expo-font"
    ]
  }
}
